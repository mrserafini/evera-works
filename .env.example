# Resend — transactional email for the contact form
# Create a free account at resend.com and paste the API key here.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Inbox that receives the lead notifications (the corporate address).
CONTACT_EMAIL=hello@everapartner.com

# Absolute site URL — used for the logo image inside the confirmation email
# and by next-sitemap at build time. Use the Vercel URL until the domain points here.
SITE_URL=https://everapartner.com

# Sanity (Phase 2)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Google Analytics 4 (optional — GA scripts only load when set)
NEXT_PUBLIC_GA_ID=
